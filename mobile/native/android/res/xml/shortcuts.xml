<?xml version="1.0" encoding="utf-8"?>
<!--
  shortcuts.xml — static App Shortcuts (long-press the app icon).

  Phase 7, docs/BUILD_PLAN.md. Unlike App Actions (actions.xml, same
  directory) these need NO external registration with Google — they
  work the moment the app is installed, which is why this is the
  Android mechanism most likely to actually work first, worth
  verifying before the fancier ones. Both shortcuts deep-link through
  the same `prosodic://` scheme the iOS side and the Quick Settings
  Tile use — see mobile/src/navigators/linking.ts for the one place
  that contract is actually defined and unit-tested.

  targetPackage/targetClass below match app.json's android.package
  ("com.prosodic.app") and Expo's generated MainActivity — confirmed
  against a real `expo prebuild` run in this repo (see
  android/app/src/main/AndroidManifest.xml, gitignored, generated),
  not assumed from the config alone.

  Icons use @mipmap/ic_launcher — the app's own icon, generated by
  every `expo prebuild` run from app.json's icon config, so guaranteed
  to exist (confirmed present under every mipmap-* density in this
  repo's own generated android/ directory). Distinct per-shortcut icon
  art (a pencil for Quick Write, a chat bubble for Quick Chat) would
  read better in the long-press menu, but that's real design asset
  work, not something to fake with placeholder files that would just
  break the build if referenced and never provided — disclosed as a
  follow-up in native/README.md, not silently skipped.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_write"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_write_short_label"
        android:shortcutLongLabel="@string/shortcut_write_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.prosodic.app"
            android:targetClass="com.prosodic.app.MainActivity"
            android:data="prosodic://write?focus=1" />
    </shortcut>
    <shortcut
        android:shortcutId="quick_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_chat_short_label"
        android:shortcutLongLabel="@string/shortcut_chat_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.prosodic.app"
            android:targetClass="com.prosodic.app.MainActivity"
            android:data="prosodic://chat" />
    </shortcut>
</shortcuts>
