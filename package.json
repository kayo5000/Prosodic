{
  "name": "prosodic",
  "description": "A Linguistics Education App that allows Musicians to use their Lyrics to study Linguistics and Music Craft by turning intuitive talent into metrics they can see, study, and master.",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.17",
    "@paper-design/shaders": "^0.0.80",
    "@remotion/player": "^4.0.524",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "lucide-react": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "remotion": "^4.0.524",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web && node scripts/postbuild.js",
    "verify": "npm run typecheck && npm run test -- --silent && npm run lint && npx expo-doctor",
    "verify:fast": "npm run typecheck && npm run test -- --silent && npm run lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
